{
  "name": "psn-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot for linking Telegram group members to one or more PSN profiles and posting summaries.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.36.1",
    "psn-api": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}

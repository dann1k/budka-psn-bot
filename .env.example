# Supabase Edge Function runtime secrets.
# Set these in Supabase with `supabase secrets set`.
BUDKA_PSN_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BUDKA_PSN_TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret
BUDKA_PSN_NPSSO=your_psn_npsso
BUDKA_PSN_SUPABASE_SECRET_KEY=your_supabase_secret_key

# GitHub Actions deployment secrets.
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_DB_URL=your_percent_encoded_supabase_db_url
